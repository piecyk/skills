{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*slack_(send_message|send_message_draft|schedule_message)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/require-natural-message.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
